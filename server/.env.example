# Baz done PostgreSQL
DATABASE_URL="postgresql://mondialito:changeme@db:5432/mondialito?schema=public"

# Sekrè JWT (chanje valè sa a pou yon chèn alewa alewa long anvan pwodiksyon)
JWT_ACCESS_SECRET="change_me_access_secret_min_32_chars"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_32_chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Sèvè
PORT=4000
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="production"

# Kont admin inisyal (kreye otomatikman pa seed si li pa egziste)
SEED_ADMIN_EMAIL="admin@mondialito.example"
SEED_ADMIN_PASSWORD="ChangeMeNow123!"

# Imèl (opsyonèl — si vid, kòd OTP ap parèt nan log sèvè a sèlman)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mondialito <no-reply@mondialito.example>"

# Laj minimòm obligatwa pou enskri
MIN_AGE_YEARS=18

# Depo minimòm pa defo (HTG)
MIN_DEPOSIT_HTG=500

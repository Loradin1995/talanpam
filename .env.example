# Kopye fichye sa a rele l ".env" nan menm dosye a, epi ranpli valè yo anvan
# ou lanse "docker compose up -d --build".

# Modpas baz done PostgreSQL (chanje l anvan pwodiksyon)
POSTGRES_PASSWORD=changeme_postgres_password

# Sekrè JWT — jenere yo ak yon kòmand tankou: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

# Domèn(n) ki gen dwa rele API a (egzanp: https://mondialito.com). Kite * pandan tès.
CORS_ORIGIN=*

# Kont admin inisyal — kreye otomatikman premye fwa a si li pa egziste
SEED_ADMIN_EMAIL=admin@mondialito.example
SEED_ADMIN_PASSWORD=ChangeMeNow123!

# Imèl (opsyonèl) — si vid, kòd OTP yo ap parèt sèlman nan log sèvè a
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mondialito <no-reply@mondialito.example>

# Règ platfòm
MIN_AGE_YEARS=18
MIN_DEPOSIT_HTG=500

# Pò kote sit la ap aksesib sou sèvè a (egzanp: 8080 → http://sèvè-ou:8080)
WEB_PORT=8080
